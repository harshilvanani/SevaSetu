# Supabase project (public values — safe to ship in the app bundle; RLS protects the data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public website address. Sign-up confirmation and password-reset emails link here.
# Leave empty for local development (links then point at the page you're on).
EXPO_PUBLIC_SITE_URL=

# Only for scripts/db.mjs and scripts/gen-types.sh (never prefix with EXPO_PUBLIC_)
# SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# SUPABASE_ACCESS_TOKEN=sbp_...
