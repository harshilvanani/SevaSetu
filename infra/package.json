{
  "name": "sevasetu-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK definition of SevaSetu's target AWS setup (ADR-003). Synth only until the move is approved.",
  "scripts": {
    "synth": "cdk synth -c env=dev",
    "synth:staging": "cdk synth -c env=staging",
    "synth:prod": "cdk synth -c env=prod",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "aws-cdk": "2.1148.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
